    <string name="moeda_auto">Automatic</string>
    <string name="ajustes_moeda_ajuda">Automatic follows the language: Portuguese shows reais, English and Spanish show dollars. Pin it here and the choice applies to the list, the coin sheet, alerts and the widget.</string>
