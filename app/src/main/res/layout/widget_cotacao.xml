<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRaiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_widget"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.12"
            android:text="@string/widget_titulo"
            android:textColor="@color/btc"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/marca_curta"
            android:textColor="@color/mint"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/wPreco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_carregando"
        android:textColor="@color/tinta"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wVar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/alta"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wEth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/tinta2"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/wRodape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/apagado"
        android:textSize="11sp" />
</LinearLayout>
